generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum Role {
  ORGANIZADOR
  CLIENTE
  PORTARIA
}

enum EventType {
  SEATED
  GENERAL
}

enum TicketStatus {
  RESERVED
  PAID
  VALIDATED
  CANCELLED
}

enum ExternalSource {
  TMDB
  TICKETMASTER
  CUSTOM
}

// ----------------------------------------------------
// Módulo: IDENTITY (Bounded Context de Acesso e Usuários)
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CLIENTE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ----------------------------------------------------
// Módulo: EVENTS (Bounded Context do Ciclo de Vida do Evento)
// ----------------------------------------------------

model Event {
  id             String         @id @default(uuid())
  organizerId    String         @map("organizer_id")
  externalApiId  String?        @map("external_api_id")
  externalSource ExternalSource @default(CUSTOM) @map("external_source")

  title       String
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  location    String
  date        DateTime

  type     EventType @default(SEATED)
  capacity Int
  price    Decimal   @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@map("events")
}

// ----------------------------------------------------
// Módulo: TICKETS (Bounded Context de Ingressos, Reservas e Portaria)
// ----------------------------------------------------

model Ticket {
  id       String @id @default(uuid())
  eventId  String @map("event_id")
  clientId String @map("client_id")

  seatNumber      String?      @map("seat_number")
  qrCodeSignature String       @unique @map("qr_code_signature")
  shareToken      String       @unique @default(uuid()) @map("share_token")
  status          TicketStatus @default(RESERVED)
  reservedUntil   DateTime?    @map("reserved_until")

  validatedAt   DateTime? @map("validated_at")
  validatedById String?   @map("validated_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId, status])
  @@index([clientId])
  @@index([shareToken])
  @@index([qrCodeSignature])
  @@map("tickets")
}
